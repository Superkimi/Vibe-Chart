# Optional server-managed OpenAI-compatible provider.
# Browser session settings take precedence when supplied.
VIBE_CHART_BASE_URL=https://api.openai.com/v1
VIBE_CHART_API_KEY=

# Optional self-hosted Kroki gateway for advanced PlantUML, Graphviz, D2 and DBML rendering.
# Keep this server-side only; the browser talks to /api/render/kroki.
VIBE_CHART_KROKI_BASE_URL=http://127.0.0.1:30248
VIBE_CHART_KROKI_ENGINES=plantuml,graphviz,d2,dbml
VIBE_CHART_KROKI_VERSION=0.32.0
VIBE_CHART_KROKI_TIMEOUT_MS=12000
